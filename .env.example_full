MEMBERS_UPDATE_ID = members_update_discord_id
SUGGESTION_CHANNEL_ID = suggestion_channel_discord_id
GUILD_UPDATE_ID = guild_update_discord_id

SENTRY_DSN = https://key@sentry.io/0

SERVER = "dev|prod"
# Optional, on|off. Overrides superuser mode (dev turns it on by default, prod uses the config value).
# SERVER=dev + SUPERUSER_MODE=off = dev bot (DEV_TOKEN) that everyone can use
SUPERUSER_MODE =