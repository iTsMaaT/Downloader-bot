DATABASE_PATH = ./data/bot.db

# Google Drive (/drive login), OAuth client of type "TVs and Limited Input devices"
GOOGLE_CLIENT_ID = google_oauth_client_id
GOOGLE_CLIENT_SECRET = google_oauth_client_secret
# Any long random string, used to encrypt stored refresh tokens (changing it unlinks everyone)
GOOGLE_DRIVE_TOKEN_KEY = random_secret_string

DEEZER_MASTER_KEY = deezer_master_key
DEEZER_ARL_COOKIE = deezer_arl_cookie

OWNER_ID = bot_owner_discord_id
